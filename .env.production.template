# PRODUCTION ENVIRONMENT CONFIGURATION
# WARNING: Never commit this file with real secrets!
# Copy to .env.production and fill in real values before deploying.

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Agent Red-Teaming Framework"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_MINIMUM_64_BYTES"
API_V1_PREFIX="/api/v1"

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/redteam"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# REDIS / CELERY
# =============================================================================
REDIS_URL="redis://redis:6379/0"
REDIS_MAX_CONNECTIONS=50
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"

# =============================================================================
# FRONTEND
# =============================================================================
NEXT_PUBLIC_API_URL="https://api.yourdomain.com/api/v1"
API_PROXY_TARGET="http://backend:8000/api/v1"

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_ALGORITHM="RS256"
JWT_PRIVATE_KEY_PATH="/secrets/jwt_private_key.pem"
JWT_PUBLIC_KEY_PATH="/secrets/jwt_public_key.pem"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS="https://app.yourdomain.com,https://api.yourdomain.com"
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# LLM PROVIDERS
# =============================================================================
PRIMARY_JUDGE_PROVIDER="openai"
PRIMARY_JUDGE_MODEL="gpt-4o-2024-08-06"
PRIMARY_JUDGE_API_KEY="sk-..."
SECONDARY_JUDGE_PROVIDER="anthropic"
SECONDARY_JUDGE_MODEL="claude-3-5-sonnet-20241022"
SECONDARY_JUDGE_API_KEY="sk-ant-..."
GENERATOR_PROVIDER="openai"
GENERATOR_MODEL="gpt-4o-2024-08-06"
GENERATOR_API_KEY="sk-..."
EVAL_MODE="production"

# =============================================================================
# SECURITY
# =============================================================================
DEV_SEED_DATA=false
DEV_MOCK_TARGET_AGENT=false
DEV_MOCK_JUDGE=false

# =============================================================================
# STORAGE
# =============================================================================
STORAGE_BACKEND="s3"
S3_ENDPOINT_URL="https://s3.amazonaws.com"
S3_ACCESS_KEY="YOUR_S3_ACCESS_KEY"
S3_SECRET_KEY="YOUR_S3_SECRET_KEY"
S3_BUCKET="production-redteam-artifacts"
S3_REGION="us-east-1"

# =============================================================================
# POSTGRES / MINIO / GRAFANA SECRETS
# =============================================================================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace_with_a_strong_password"
POSTGRES_DB="redteam"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="replace_with_a_strong_password"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="replace_with_a_strong_password"
