{
  "title": "RedTeam Framework Overview",
  "tags": [
    "redteam",
    "overview"
  ],
  "timezone": "utc",
  "panels": [
    {
      "title": "Total Runs",
      "type": "stat",
      "targets": [
        {
          "expr": "redteam_runs_total",
          "legendFormat": "Total Runs"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Pass Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "redteam_pass_rate",
          "legendFormat": "Pass Rate %"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Active Regressions",
      "type": "stat",
      "targets": [
        {
          "expr": "redteam_regressions_active",
          "legendFormat": "Active Regressions"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Critical Findings",
      "type": "stat",
      "targets": [
        {
          "expr": "redteam_critical_findings",
          "legendFormat": "Critical Findings"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Runs Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(redteam_runs_created_total[5m])",
          "legendFormat": "Runs/sec"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Run Duration",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, redteam_run_duration_seconds_bucket)",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, redteam_run_duration_seconds_bucket)",
          "legendFormat": "p50"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Cost Tracking",
      "type": "timeseries",
      "targets": [
        {
          "expr": "redteam_cost_usd_total",
          "legendFormat": "Total Cost USD"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Review Queue Size",
      "type": "timeseries",
      "targets": [
        {
          "expr": "redteam_review_queue_size",
          "legendFormat": "Pending Reviews"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "uid": "redteam-overview",
  "schemaVersion": 38
}
